  "calculators": [
    {
      "key": "net_sale_price",
      "type": "layered_price",
      "title": {
        "fa": "محاسبه قیمت فروش خالص با کسر وزن جعبه",
        "en": "Net sales price after box tare deduction"
      },
      "inputs": [
        {
          "key": "gross_weight_grams",
          "type": "decimal",
          "min": 1,
          "title": {
            "fa": "وزن ناخالص به همراه جعبه (گرم)",
            "en": "Gross weight with box (g)"
          }
        },
        {
          "key": "price_per_kg",
          "type": "decimal",
          "min": 0,
          "title": {
            "fa": "قیمت هر کیلوگرم شیرینی (ریال)",
            "en": "Price per kg (Rial)"
          }
        }
      ],
      "components": [
        {
          "key": "net_pastry_amount",
          "type": "product",
          "factors": [
            "gross_weight_grams",
            "price_per_kg"
          ],
          "subtract": {
            "gross_weight_grams": "default_box_tare_grams"
          },
          "divide_by_setting": "grams_per_kg",
          "title": {
            "fa": "مبلغ شیرینی خالص (پس از کسر وزن جعبه)",
            "en": "Net pastry price (tare deducted)"
          }
        }
      ],
      "params": {
        "money_decimals": 0
      }
    },
    {
      "key": "unit_convert",
      "type": "unit_convert",
      "title": {
        "fa": "تبدیل واحدهای وزن شیرینی و جعبه",
        "en": "Pastry weight and box unit conversion"
      },
      "inputs": [
        {
          "key": "value",
          "type": "decimal",
          "min": 0,
          "title": {
            "fa": "مقدار",
            "en": "Value"
          }
        },
        {
          "key": "from",
          "type": "select",
          "options": [
            "kg",
            "gram",
            "box_half",
            "box_one",
            "box_two"
          ],
          "title": {
            "fa": "از واحد",
            "en": "From unit"
          }
        },
        {
          "key": "to",
          "type": "select",
          "options": [
            "kg",
            "gram",
            "box_half",
            "box_one",
            "box_two"
          ],
          "title": {
            "fa": "به واحد",
            "en": "To unit"
          }
        }
      ],
      "params": {
        "units": {
          "kg": 1,
          "gram": 0.001,
          "box_half": 0.5,
          "box_one": 1,
          "box_two": 2
        },
        "decimals": 3
      }
    }
  ]
